{
  "uid": "airq-overview",
  "title": "Indoor air quality",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "airq"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CO2 (ppm), ventilate above 1000",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "airq-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"airq\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"airq\" and (r._field == \"co2_ppm\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "airq-influx"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "PM2.5 and 24h mean (ug/m3)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "airq-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "conmgm3"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"airq\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"airq\" and (r._field == \"pm2_5\" or r._field == \"pm2_5_24h_mean\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "airq-influx"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature and dew point (C)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "airq-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"airq\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"airq\" and (r._field == \"temperature_c\" or r._field == \"dew_point_c\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "airq-influx"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Humidity (%RH) and absolute (g/m3)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "airq-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"airq\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"airq\" and (r._field == \"humidity_pct\" or r._field == \"abs_humidity_gm3\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "airq-influx"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "VOC and NOx index",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "airq-influx"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"airq\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"airq\" and (r._field == \"voc_index\" or r._field == \"nox_index\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "airq-influx"
          }
        }
      ]
    }
  ]
}
